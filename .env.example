# Sill Garden — local analytics / dashboard (never commit real secrets)

# Client-side GA4 (also set PUBLIC_GA4_ID in Cloudflare Pages env for production builds)
PUBLIC_GA4_ID=

# Google APIs (reuse MTS service account if it has access to this GA4 + GSC property)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or: GOOGLE_AUTH=oauth with the same token files as Maker Tool Stack
# GOOGLE_AUTH=oauth
# GOOGLE_OAUTH_CLIENT_JSON=../makertoolstack/secrets/google-oauth-client.json
# GOOGLE_USER_TOKEN_JSON=../makertoolstack/secrets/google-user-token.json

GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:sillgarden.com

# Cloudflare (zone already created for sillgarden.com)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=37b02453651a4e74cc1eaed7241a6338

# YouTube (optional — channel for Sill Garden content)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=
# YOUTUBE_CHANNEL_ID=
# Upload OAuth (separate from GA4/GSC — authorize while switched to Sill Garden)
# YOUTUBE_USER_TOKEN_JSON=secrets/youtube-user-token.json
# YOUTUBE_OAUTH_CLIENT_JSON=../makertoolstack/secrets/google-oauth-client.json
# AUTOMATION_LIVE=0

# Amazon Associates — no public earnings API; paste into products/analytics/amazon-manual.json

# Direct affiliate programs (paste the full approved tracking/deep link)
PUBLIC_CLICK_GROW_AFFILIATE_URL=
PUBLIC_GARDENERS_SUPPLY_AFFILIATE_URL=

# IndexNow (Bing/Yandex discovery)
INDEXNOW_KEY=
# Optional: reuse MTS Bing Webmaster API key
# BING_WEBMASTER_API_KEY=

# Growth automations (optional — scripts no-op when unset)
# AUTOMATION_LIVE=1
# GROWTH_REPORT_EMAIL=
# GROWTH_SMTP_HOST=
# GROWTH_SMTP_USER=
# GROWTH_SMTP_PASS=
# GROWTH_SMTP_PORT=587
# DEVTO_API_KEY=
# HASHNODE_PAT=
# HASHNODE_PUBLICATION_ID=
# MASTODON_INSTANCE=
# MASTODON_ACCESS_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# IA_ACCESS_KEY=
# IA_SECRET_KEY=
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=


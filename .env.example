# Sill Garden — local analytics / dashboard (never commit real secrets)

# Client-side GA4 (also set PUBLIC_GA4_ID in Cloudflare Pages env for production builds)
PUBLIC_GA4_ID=

# Google APIs (reuse MTS service account if it has access to this GA4 + GSC property)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or: GOOGLE_AUTH=oauth with the same token files as Maker Tool Stack
# GOOGLE_AUTH=oauth
# GOOGLE_OAUTH_CLIENT_JSON=../makertoolstack/secrets/google-oauth-client.json
# GOOGLE_USER_TOKEN_JSON=../makertoolstack/secrets/google-user-token.json

GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:sillgarden.com

# Cloudflare (zone already created for sillgarden.com)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=37b02453651a4e74cc1eaed7241a6338

# YouTube (optional — channel for Sill Garden content)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=
# YOUTUBE_CHANNEL_ID=

# Amazon Associates — no public earnings API; paste into products/analytics/amazon-manual.json

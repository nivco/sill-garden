---
import { productLink, type ProductLinkInput } from '../lib/amazon';

interface Props {
  products: ProductLinkInput[];
  primaryName?: string;
}

const { products, primaryName } = Astro.props;

const cards = products.map((p) => {
  const link = productLink(p);
  const isPrimary = primaryName ? p.name === primaryName : false;
  return { ...p, ...link, isPrimary };
});
---

<div class="stack">
  {
    cards.map((p, i) => (
      <article class:list={['stack__card', p.isPrimary && 'stack__card--primary']}>
        <div class="stack__meta">
          <span class="stack__rank">{p.isPrimary || i === 0 ? 'Buy first' : `Add-on ${i}`}</span>
          <h3>{p.name}</h3>
          {p.note && <p>{p.note}</p>}
        </div>
        {p.href ? (
          <a
            class:list={['btn', p.isPrimary || i === 0 ? 'btn-primary' : 'btn-ghost']}
            href={p.href}
            rel="nofollow sponsored noopener"
            target="_blank"
            data-affiliate-network={p.network}
            data-affiliate-product={p.name}
            data-affiliate-merchant={p.merchant}
          >
            Check price at {p.merchant}
          </a>
        ) : (
          <p class="stack__soon">Link coming soon</p>
        )}
      </article>
    ))
  }
</div>

<style>
  .stack {
    display: grid;
    gap: 0.85rem;
  }

  .stack__card {
    display: grid;
    gap: 0.85rem;
    align-items: start;
    padding: 1.1rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  @media (min-width: 640px) {
    .stack__card {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .stack__card--primary {
    border-color: var(--leaf);
    box-shadow: var(--shadow);
  }

  .stack__rank {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--harvest);
    margin-bottom: 0.25rem;
  }

  .stack__card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .stack__card p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .stack__soon {
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>

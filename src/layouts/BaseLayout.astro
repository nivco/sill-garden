---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/hero-sill.jpg',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {
      site.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} />
          <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4Id, { send_page_view: true });
            document.addEventListener('click', function (e) {
              var el = e.target && e.target.closest ? e.target.closest('a') : null;
              if (!el || !el.href) return;
              var u;
              try {
                u = new URL(el.href, location.href);
              } catch (err) {
                return;
              }
              if (u.hostname === location.hostname) return;
              var rel = (el.getAttribute('rel') || '').toLowerCase();
              var host = u.hostname.replace(/^www\./, '').toLowerCase();
              var isAmazon = host === 'amazon.com' || host.endsWith('.amazon.com');
              var isAffiliate = rel.indexOf('sponsored') !== -1 || isAmazon;
              var payload = {
                link_url: u.href,
                link_domain: u.hostname,
                affiliate_network: el.getAttribute('data-affiliate-network') || (isAmazon ? 'amazon-associates' : ''),
                affiliate_merchant: el.getAttribute('data-affiliate-merchant') || host,
                affiliate_product: el.getAttribute('data-affiliate-product') || '',
                page_path: location.pathname,
              };
              if (isAffiliate) {
                gtag('event', 'affiliate_click', payload);
                var networkEvent = {
                  'amazon-associates': 'affiliate_click_amazon',
                  'click-grow': 'affiliate_click_click_grow',
                  'gardeners-supply': 'affiliate_click_gardeners_supply',
                }[payload.affiliate_network];
                if (networkEvent) gtag('event', networkEvent, payload);
              } else {
                gtag('event', 'outbound_click', payload);
              }
            });
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Primary">
          <a href="/guides/" aria-current={path.startsWith('/guides') ? 'page' : undefined}>Guides</a>
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
          <a href="/disclosure/" aria-current={path.startsWith('/disclosure') ? 'page' : undefined}
            >Disclosure</a
          >
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <strong style="color: var(--leaf-deep); font-family: var(--font-display); font-size: 1.15rem;">
            {site.name}
          </strong>
          <p style="margin: 0.4rem 0 0; max-width: 36rem;">{site.tagline}</p>
        </div>
        <nav aria-label="Footer">
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
          <a href="/disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/credits/">Photo credits</a>
          <a href="/feed.xml">RSS</a>
        </nav>
        <p style="margin: 0;">
          © {new Date().getFullYear()} {site.name}. For apartments & small kitchens. Photos via
          <a href="/credits/">Openverse / CC</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/hero-sill.jpg',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav" aria-label="Primary">
          <a href="/guides/" aria-current={path.startsWith('/guides') ? 'page' : undefined}>Guides</a>
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
          <a href="/disclosure/" aria-current={path.startsWith('/disclosure') ? 'page' : undefined}
            >Disclosure</a
          >
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <strong style="color: var(--leaf-deep); font-family: var(--font-display); font-size: 1.15rem;">
            {site.name}
          </strong>
          <p style="margin: 0.4rem 0 0; max-width: 36rem;">{site.tagline}</p>
        </div>
        <nav aria-label="Footer">
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
          <a href="/disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
        </nav>
        <p style="margin: 0;">© {new Date().getFullYear()} {site.name}. For apartments & small kitchens.</p>
      </div>
    </footer>
  </body>
</html>

---
import BaseLayout from '../../layouts/BaseLayout.astro';

const description =
  'Printable 1-page apartment herb garden checklist — light, trays, quiet kits, and first herbs for a rental kitchen.';
---

<BaseLayout title="Apartment herb checklist" description={description} image="/images/guide-herbs.jpg">
  <section class="wrap checklist fade-up">
    <div class="checklist__toolbar no-print">
      <p class="tool__eyebrow">Free printable</p>
      <button type="button" class="btn btn-primary" id="print-btn">Print / save as PDF</button>
    </div>

    <article class="sheet">
      <header class="sheet__header">
        <p class="sheet__brand">Sill Garden</p>
        <h1>Apartment herb garden checklist</h1>
        <p class="sheet__sub">One page. Renter-safe. Focused on light, drips, noise, and herbs you will actually eat.</p>
      </header>

      <section>
        <h2>Before you buy</h2>
        <ul class="checks">
          <li>□ Measure counter depth (kit must not hang over the edge)</li>
          <li>□ Decide: separate kitchen vs studio/bedroom (noise rule)</li>
          <li>□ Check for a waterproof tray / boot path (deposit insurance)</li>
          <li>□ Confirm an outlet within cord reach — no extension spaghetti</li>
          <li>□ Pick 2–3 herbs you cook weekly (ignore the 12-pod fantasy)</li>
        </ul>
      </section>

      <section>
        <h2>Starter lanes</h2>
        <table>
          <thead>
            <tr>
              <th>If you…</th>
              <th>Start with</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Sleep near the kit</td>
              <td>Click & Grow Smart Garden 3 (silent wick)</td>
            </tr>
            <tr>
              <td>Have a kitchen corner</td>
              <td>AeroGarden Harvest-class (~6 pods)</td>
            </tr>
            <tr>
              <td>Want under ~$50</td>
              <td>3 pots + saucers + clip light (if sill is weak)</td>
            </tr>
            <tr>
              <td>Want silence + DIY</td>
              <td>Kratky jar + tray + one LED</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section>
        <h2>First herbs that forgive apartments</h2>
        <ul class="checks">
          <li>□ Basil — fast, needs strong light</li>
          <li>□ Mint — forgiving; keep in its own pot</li>
          <li>□ Chives — cut-and-come-again</li>
          <li>□ Parsley — slower; keep evenly moist</li>
          <li>□ Skip cilantro early — bolts fast indoors</li>
        </ul>
      </section>

      <section>
        <h2>Week-one ops</h2>
        <ul class="checks">
          <li>□ Lights ~14–16h; dark while you sleep</li>
          <li>□ Top up water before the reservoir hits empty</li>
          <li>□ Empty the drip tray — never leave a puddle overnight</li>
          <li>□ Pinch tops when plants get leggy</li>
          <li>□ After cycle one: note which pods you actually ate</li>
        </ul>
      </section>

      <footer class="sheet__footer">
        <p>
          Free tools: sillgarden.com/tools/kit-picker/ · Guides: sillgarden.com/guides/ · Disclosure:
          sillgarden.com/disclosure/
        </p>
        <p>Independent apartment herb guides — not affiliated with The Sill.</p>
      </footer>
    </article>

    <p class="checklist__next no-print">
      Next:
      <a href="/kits/">Starter kits</a>
      ·
      <a href="/tools/kit-picker/">Run the kit picker</a>
      ·
      <a href="/tools/year-one-cost/">Year-one cost</a>
    </p>
  </section>
</BaseLayout>

<style>
  .checklist {
    padding: 2rem 0 3rem;
    max-width: 46rem;
  }

  .tool__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--harvest);
  }

  .checklist__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .sheet {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem 1.75rem;
    box-shadow: var(--shadow);
  }

  .sheet__brand {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    color: var(--leaf-deep);
    font-size: 1.15rem;
  }

  .sheet h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .sheet__sub {
    margin: 0 0 1.25rem;
    color: var(--ink-muted);
  }

  .sheet h2 {
    margin: 1.15rem 0 0.5rem;
    font-size: 1.15rem;
    color: var(--leaf-deep);
  }

  .checks {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .checks li {
    margin: 0.35rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    border: 1px solid var(--line);
    padding: 0.45rem 0.55rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: rgba(47, 93, 58, 0.08);
  }

  .sheet__footer {
    margin-top: 1.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .sheet__footer p {
    margin: 0.25rem 0;
  }

  .checklist__next {
    margin-top: 1.25rem;
    color: var(--ink-muted);
  }

  @media print {
    :global(body) {
      background: #fff !important;
    }

    :global(.site-header),
    :global(.site-footer),
    .no-print {
      display: none !important;
    }

    .checklist {
      padding: 0;
      max-width: none;
    }

    .sheet {
      border: none;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
    }

    .sheet h1 {
      font-size: 18pt;
    }

    .sheet h2 {
      font-size: 12pt;
      margin-top: 10pt;
    }
  }
</style>

<script is:inline>
  document.getElementById('print-btn')?.addEventListener('click', function () {
    window.print();
  });
</script>

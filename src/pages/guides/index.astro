---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { clusters } from '../../lib/site';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const byCluster = Object.fromEntries(
  Object.keys(clusters).map((key) => [key, guides.filter((g) => g.data.cluster === key)]),
) as Record<keyof typeof clusters, typeof guides>;
---

<BaseLayout
  title="Guides"
  description="Countertop systems, sill herbs, and apartment setup guides from Sill Garden."
>
  <section class="wrap page">
    <header class="page__header fade-up">
      <h1>Guides</h1>
      <p>Practical pages for growing on a windowsill or kitchen counter — no backyard required.</p>
    </header>

    {
      (Object.keys(clusters) as Array<keyof typeof clusters>).map((key) => (
        <section class="cluster" id={key}>
          <h2>{clusters[key].title}</h2>
          <p class="cluster__blurb">{clusters[key].blurb}</p>
          <div class="cluster__grid">
            {byCluster[key].map((g) => (
              <a class="guide-card" href={`/guides/${g.id}/`}>
                {g.data.image && (
                  <img src={g.data.image} alt="" width="640" height="400" loading="lazy" />
                )}
                <div class="guide-card__body">
                  <span class="guide-card__type">{g.data.type}</span>
                  <strong>{g.data.title}</strong>
                  <span class="guide-card__desc">{g.data.description}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page {
    padding: 2.75rem 0 1rem;
  }

  .page__header h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  .page__header p {
    color: var(--ink-muted);
    max-width: 36rem;
  }

  .cluster {
    margin-top: 2.75rem;
    padding-top: 0.5rem;
  }

  .cluster h2 {
    margin: 0 0 0.35rem;
    color: var(--leaf-deep);
  }

  .cluster__blurb {
    margin: 0 0 1.15rem;
    color: var(--ink-muted);
  }

  .cluster__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16.5rem, 1fr));
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: var(--shadow);
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .guide-card:hover {
    transform: translateY(-3px);
    border-color: var(--leaf);
    color: inherit;
  }

  .guide-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .guide-card__body {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  .guide-card__type {
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--harvest);
  }

  .guide-card strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 550;
    line-height: 1.25;
  }

  .guide-card__desc {
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
</style>

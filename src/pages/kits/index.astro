---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { starterKits } from '../../data/kits';
import { site } from '../../lib/site';
---

<BaseLayout
  title="Apartment starter kits"
  description="Physical apartment herb starter kits — studio silence, kitchen capacity, and under-$50 sill stacks with affiliate product links."
  image="/images/guide-herbs.jpg"
>
  <section class="wrap kits fade-up">
    <h1>Apartment starter kits</h1>
    <p class="kits__deck">
      Curated <strong>physical</strong> stacks for small kitchens — not downloadable plans AI can
      regenerate. Pick a lane, buy the kit + the accessories that actually matter.
      <a href="/disclosure/">Affiliate disclosure</a>.
    </p>

    <div class="kits__list">
      {
        starterKits.map((k) => (
          <a class="kits__card" href={`/kits/${k.slug}/`}>
            <span class="kits__eyebrow">{k.eyebrow}</span>
            <h2>{k.title}</h2>
            <p>{k.description}</p>
          </a>
        ))
      }
    </div>

    <p class="kits__more">
      Also:
      <a href="/kits/refills/">Refills & consumables</a>
      ·
      <a href="/tools/kit-picker/">Quiet kit picker</a>
      ·
      <a href="/tools/year-one-cost/">Year-one cost sheet</a>
    </p>
    <p class="kits__brand">{site.name} — independent apartment herb guides.</p>
  </section>
</BaseLayout>

<style>
  .kits {
    padding: 2.5rem 0 3.5rem;
    max-width: 42rem;
  }

  .kits h1 {
    margin: 0 0 0.6rem;
  }

  .kits__deck {
    margin: 0 0 1.5rem;
    color: var(--ink-muted);
  }

  .kits__list {
    display: grid;
    gap: 0.85rem;
  }

  .kits__card {
    display: block;
    padding: 1.2rem 1.25rem;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .kits__card:hover {
    border-color: var(--leaf);
    transform: translateY(-2px);
    color: inherit;
  }

  .kits__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--harvest);
  }

  .kits__card h2 {
    margin: 0.35rem 0 0.4rem;
    font-size: 1.3rem;
    color: var(--leaf-deep);
  }

  .kits__card p {
    margin: 0;
    color: var(--ink-muted);
  }

  .kits__more,
  .kits__brand {
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
</style>

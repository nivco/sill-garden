---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photoCredits, unsplashLicenseUrl, openverseUrl } from '../lib/photos';
---

<BaseLayout
  title="Photo credits"
  description="Stock photography credits for Sill Garden. Images via Openverse under CC0 / CC BY."
>
  <section class="wrap page fade-up">
    <h1>Photo credits</h1>
    <div class="prose content-width">
      <p>
        Site photography is sourced via <a href={openverseUrl}>Openverse</a> under
        <a href={unsplashLicenseUrl}>CC0</a> or Creative Commons licenses that allow commercial use
        on websites. We’ll replace these with our own sill photos over time.
      </p>
      <ul>
        {
          photoCredits.map((p) => (
            <li>
              <code>{p.file}</code> —{' '}
              <a href={p.url} rel="noopener noreferrer" target="_blank">
                {p.credit}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding: 2.75rem 0 1rem;
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 5vw, 3rem);
  }
  code {
    font-size: 0.9em;
  }
</style>
